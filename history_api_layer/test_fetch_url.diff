+def test_id_value_override_with_figi_param_name(fetch_env, http_log):
+    """--id-value + --id-type figi: значение уходит в параметр figi=...,
+    а не в instrument_id=... (имя параметра зависит от id_type, а не от
+    значения --id-value)."""
+    fetch = fetch_env["fetch"]
+    http_log["plan"] = [_ok_response]
+    custom_figi = "BBG000CLRAV1"
+    args = fetch.build_arg_parser().parse_args(
+        ["--id-value", custom_figi, "--id-type", "figi"])
+    meta = fetch.run_fetch(args)
+    assert meta["executed"] is True
+    q = _query_of(http_log["requests"][0]["url"])
+    assert q["figi"] == [custom_figi]
+    assert "instrument_id" not in q
+    assert q["year"] == ["2025"]
