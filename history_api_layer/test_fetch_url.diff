+# ---------- 7: специальные символы корректно URL-кодируются ----------
+
+def test_id_value_with_special_chars_is_url_encoded(fetch_env, http_log):
+    """Специальные символы в --id-value корректно кодируются
+    urllib.parse.urlencode: декодированное значение сохраняется,
+    «голых» разделителей внутри значения нет (только между параметрами)."""
+    fetch = fetch_env["fetch"]
+    http_log["plan"] = [_ok_response]
+    special = "weird&id value=with+special;chars"
+    args = fetch.build_arg_parser().parse_args(
+        ["--id-value", special, "--id-type", "uid"])
+    meta = fetch.run_fetch(args)
+    assert meta["executed"] is True
+    url = http_log["requests"][0]["url"]
+    q = _query_of(url)
+    # декодированное значение совпадает с исходным (round-trip)
+    assert q["instrument_id"] == [special]
+    assert q["year"] == ["2025"]
+    # «голой» амперсанд в URL только ОДИН — между instrument_id и year;
+    # внутри значения & закодирован как %26
+    assert url.count("&") == 1
+    # «голой» пробел в URL отсутствует (urlencode кодирует его как +)
+    assert " " not in url
+    # «голой» '=' в URL только два (после instrument_id и после year);
+    # внутри значения '=' закодирован как %3D
+    assert url.count("=") == 2
+
+
